{
  "ignition": {
    "version": "3.4.0"
  },
  "storage": {
    "directories": [
      {
        "path": "/var/opt/coreos-wings/provisioning",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "/var/opt/coreos-wings/provisioning/install.sh",
        "mode": 420,
        "contents": {
          "source": "data:;base64,"
        }
      },
      {
        "path": "/var/opt/coreos-wings/provisioning/prepare.sh",
        "mode": 420,
        "contents": {
          "source": "data:;base64,"
        }
      },
      {
        "path": "/var/opt/coreos-wings/provisioning/check.sh",
        "mode": 420,
        "contents": {
          "source": "data:;base64,"
        }
      },
      {
        "path": "/var/opt/coreos-wings/provisioning/wings.service",
        "mode": 420,
        "contents": {
          "source": "data:;base64,"
        }
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "name": "docker.service",
        "enabled": true
      },
      {
        "name": "coreos-wings-install.service",
        "enabled": true,
        "contents": "[Unit]\nDescription=Provision Pterodactyl Wings from Ignition\nWants=network-online.target\nAfter=network-online.target docker.service\nRequires=docker.service\nRequiresMountsFor=/var/opt/coreos-wings /var/lib/pterodactyl /var/lib/docker\nConditionPathExists=!/var/opt/coreos-wings/.provisioned\nStartLimitIntervalSec=0\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/bin/bash /var/opt/coreos-wings/provisioning/install.sh\nExecStartPost=/usr/bin/touch /var/opt/coreos-wings/.provisioned\nRestart=on-failure\nRestartSec=30\nTimeoutStartSec=15min\n\n[Install]\nWantedBy=multi-user.target\n"
      }
    ]
  }
}
